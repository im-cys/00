{
  "name": "viewpoint-agent-prototype",
  "version": "1.0.0",
  "description": "观点分身独立网页交互原型",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/esbuild/bin/esbuild app.js --bundle --format=iife --platform=browser --target=es2020 --outfile=app.bundle.js",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.8.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22"
  }
}
