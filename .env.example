# 云托管
HOST=0.0.0.0
PORT=3000
ALLOWED_HOSTS=*
CLOUDBASE_USE_DATABASE=true
# 在云托管中可留空，SDK 会使用当前环境；本地连接时填写环境 ID
CLOUDBASE_ENV_ID=
# PostgreSQL 后端管理员 API Key，仅配置在服务端环境变量。
CLOUDBASE_APIKEY=

# 知乎 OAuth（只配置在云托管环境变量，不要提交真实值）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_REDIRECT_URI=https://你的默认域名/auth/zhihu/callback
ZHIHU_AUTH_DEMO_MODE=false

# DeepSeek OpenAI 兼容网关（只配置在云托管环境变量）
EXTRACT_BASE_URL=https://api.openai-next.com/v1
EXTRACT_MODEL=deepseek-v4-pro
EXTRACT_API_KEY=

# 保护私有数据导入接口；请生成至少 32 字节随机值
DATA_IMPORT_TOKEN=
